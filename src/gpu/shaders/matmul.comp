// Vulkan (GLSL). Batched matmul: supports rank >= 2 with matching batch
// dimensions (no broadcasting).
//
// 1D column tiling: each workgroup computes tileWidth consecutive output
// columns of one output row. tileWidth is passed at runtime so the host can
// match the actual threadgroup size the backend uses (e.g., Metal's
// threadExecutionWidth). For Vulkan the backend currently reports a
// workgroup size of 1, so tileWidth is 1 and each workgroup computes one
// output element.
//
// The inner K-loop is vectorized with T4 loads from A (contiguous) and four
// packed scalar loads from the corresponding B rows; accumulation stays float
// with a scalar tail for the remainder.
layout(local_size_x = 1, local_size_y = 1) in;

layout(std430, binding = 0) readonly buffer ABuf { T data[]; } aBuf;
layout(std430, binding = 1) readonly buffer BBuf { T data[]; } bBuf;
layout(std430, binding = 2) buffer OutBuf { T data[]; } outputBuf;
layout(binding = 3) uniform Params
{
    uint m;
    uint k;
    uint n;
    uint batchCount;
    uint tileWidth;
} params;

vec4 toFloat4(T4 v)
{
    return vec4(TO_FLOAT(v.x), TO_FLOAT(v.y), TO_FLOAT(v.z), TO_FLOAT(v.w));
}

void main()
{
    if (gl_LocalInvocationID.x >= params.tileWidth)
        return;
    uint n = gl_WorkGroupID.x * params.tileWidth + gl_LocalInvocationID.x;
    uint m = gl_WorkGroupID.y;
    uint batch = gl_WorkGroupID.z;
    if (m >= params.m || n >= params.n || batch >= params.batchCount)
        return;

    uint mn = params.m * params.n;
    uint mk = params.m * params.k;
    uint kn = params.k * params.n;
    uint aOffset = batch * mk;
    uint bOffset = batch * kn;
    uint outOffset = batch * mn;

    uint aRow = aOffset + m * params.k;
    uint nVal = n;
    uint kDim = params.k;
    uint nDim = params.n;

    float sum = 0.0;
    uint i = 0u;
    for (; i + 3u < kDim; i += 4u)
    {
        T4 a = T4(aBuf.data[aRow + i],
                  aBuf.data[aRow + i + 1u],
                  aBuf.data[aRow + i + 2u],
                  aBuf.data[aRow + i + 3u]);
        float b0 = TO_FLOAT(bBuf.data[bOffset + (i + 0u) * nDim + nVal]);
        float b1 = TO_FLOAT(bBuf.data[bOffset + (i + 1u) * nDim + nVal]);
        float b2 = TO_FLOAT(bBuf.data[bOffset + (i + 2u) * nDim + nVal]);
        float b3 = TO_FLOAT(bBuf.data[bOffset + (i + 3u) * nDim + nVal]);
        sum += dot(toFloat4(a), vec4(b0, b1, b2, b3));
    }
    for (; i < kDim; ++i)
        sum += TO_FLOAT(aBuf.data[aRow + i]) * TO_FLOAT(bBuf.data[bOffset + i * nDim + nVal]);

    outputBuf.data[outOffset + m * nDim + nVal] = TO_T(sum);
}
